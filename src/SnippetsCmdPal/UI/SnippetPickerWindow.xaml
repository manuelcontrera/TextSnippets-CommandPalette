<ui:FluentWindow x:Class="SnippetsCmdPal.UI.SnippetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Seleccionar Snippet"
        Width="480"
        MinWidth="400"
        MaxHeight="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">

    <Border BorderThickness="1"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="12"
            Padding="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MaxHeight="340" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="4,0,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TxtHeader"
                               Text="⚡ Text Snippets"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TxtSubtitle"
                               Text="Presiona 1-9 o usa flechas y Enter para pegar"
                               FontSize="12"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Content="✕"
                           Padding="8,4"
                           Appearance="Secondary"
                           Click="OnCloseClicked"
                           ToolTip="Cancelar (Esc)" />
            </Grid>

            <!-- Search / Filter Box -->
            <ui:TextBox Grid.Row="1"
                        x:Name="TxtSearch"
                        PlaceholderText="Filtrar opciones..."
                        Margin="0,0,0,10"
                        ClearButtonEnabled="True"
                        TextChanged="OnSearchTextChanged"
                        PreviewKeyDown="OnSearchPreviewKeyDown" />

            <!-- Options List -->
            <ListBox Grid.Row="2"
                     x:Name="LstOptions"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseDoubleClick="OnListDoubleClick"
                     PreviewKeyDown="OnListPreviewKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Shortcut badge (1, 2, 3...) -->
                            <Border Grid.Column="0"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding IndexNumber}"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>

                            <!-- Title and Content -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding ContentPreview}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer Hint -->
            <Grid Grid.Row="3" Margin="4,10,4,0">
                <TextBlock Text="[Enter] Pegar  •  [1-9] Seleccionar  •  [Esc] Cancelar"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
